# Copy to .env and adjust. .env is gitignored; this file is not.

# --- App ---
# local | staging | production (production hides /docs)
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# --- Docker services (read by docker-compose.yml) ---
POSTGRES_USER=cct
POSTGRES_PASSWORD=cct_dev_password
POSTGRES_DB=cct
REDIS_PASSWORD=redis_dev_password
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin_dev_password

# --- Connections (must match the values above) ---
DATABASE_URL=postgresql+asyncpg://cct:cct_dev_password@localhost:5432/cct
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# --- Auth ---
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_DAYS=30
REFRESH_GRACE_SECONDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Browser ---
CORS_ORIGINS=["http://localhost:5173"]
# browsers accept Secure cookies on http://localhost
COOKIE_SECURE=true
# use "none" (with COOKIE_SECURE=true) if frontend and API are on different sites
COOKIE_SAMESITE=lax
